<mxfile host="app.diagrams.net" version="22.0.0" type="device"><diagram id="lawyer-matching-appointments-enhanced" name="Lawyer Matching &amp; Appointments Flow"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="1200" background="#F8FAFC" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr" value="&lt;div style=&quot;font-size:16px;font-weight:800;color:#0F172A;&quot;&gt;Attorney.AI — Complete Lawyer Matching, Consultation &amp;amp; Hire Journey&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#64748B;margin-top:3px;&quot;&gt;Comprehensive 6-Stage Architecture: AI Vector Matching → Availability Subtraction → Idempotent Booking → Lawyer Decision Triage → Live Daily.co Session → Case Hire&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;arcSize=6;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1980" height="55" as="geometry" /></mxCell><mxCell id="col1" value="  STAGE 1: AI CASE MATCHING" style="swimlane;startSize=30;fillColor=#BAE6FD;strokeColor=#BAE6FD;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#EFF6FF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="310" height="1000" as="geometry" /></mxCell><mxCell id="col2" value="  STAGE 2: SLOT AVAILABILITY ENGINE" style="swimlane;startSize=30;fillColor=#99F6E4;strokeColor=#99F6E4;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#F0FDFA;collapsible=0;" vertex="1" parent="1"><mxGeometry x="370" y="90" width="310" height="1000" as="geometry" /></mxCell><mxCell id="col3" value="  STAGE 3: IDEMPOTENT BOOKING HOLD" style="swimlane;startSize=30;fillColor=#FDE68A;strokeColor=#FDE68A;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#FEF3C7;collapsible=0;" vertex="1" parent="1"><mxGeometry x="700" y="90" width="310" height="1000" as="geometry" /></mxCell><mxCell id="col4" value="  STAGE 4: LAWYER TRIAGE &amp; BRANCHING" style="swimlane;startSize=30;fillColor=#DDD6FE;strokeColor=#DDD6FE;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#FAF5FF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1030" y="90" width="350" height="1000" as="geometry" /></mxCell><mxCell id="col5" value="  STAGE 5: LIVE VIDEO SESSION (DAILY.CO)" style="swimlane;startSize=30;fillColor=#FBCFE8;strokeColor=#FBCFE8;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#FDF2F8;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1400" y="90" width="310" height="1000" as="geometry" /></mxCell><mxCell id="col6" value="  STAGE 6: OUTCOME &amp; HIRE UNLOCK" style="swimlane;startSize=30;fillColor=#A7F3D0;strokeColor=#A7F3D0;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#ECFDF5;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1730" y="90" width="290" height="1000" as="geometry" /></mxCell><mxCell id="s1_ui" value="&lt;b style=&quot;color:#0284C7;font-size:12px;&quot;&gt;Client: Directory &amp;amp; Matching&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Browse Directory (/lawyers, 20/page)&lt;br/&gt;• 7 Practice Area chips + Province filter&lt;br/&gt;• &lt;b&gt;AI Match trigger&lt;/b&gt;: ?case_id=... (from Intake)&lt;br/&gt;• Fallback: &quot;Describe problem&quot; Roman Urdu box&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="45" width="280" height="90" as="geometry" /></mxCell><mxCell id="s1_api" value="&lt;span style=&quot;background:#E0F2FE;color:#0369A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;GET&lt;/span&gt; &lt;b&gt;/api/v1/lawyers&lt;/b&gt; (filters, q, sort)&lt;br/&gt;&lt;span style=&quot;background:#E0F2FE;color:#0369A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;GET&lt;/span&gt; &lt;b&gt;/api/v1/lawyers/counts&lt;/b&gt; (chips count)&lt;br/&gt;&lt;span style=&quot;background:#EDE9FE;color:#6D28D9;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;GET&lt;/span&gt; &lt;b&gt;/lawyers/match/{case_id}&lt;/b&gt; (AI match)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="160" width="280" height="80" as="geometry" /></mxCell><mxCell id="s1_svc" value="&lt;b&gt;lawyer_service.py (Matching Engine)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;• Refuses draft cases (422 case_draft)&lt;br/&gt;• Queries &lt;b&gt;lawyer_embeddings&lt;/b&gt; vector pool&lt;br/&gt;• Merges province, specialization &amp;amp; rating&lt;br/&gt;• Returns top 5 with match_score &amp;amp; reason&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="265" width="280" height="95" as="geometry" /></mxCell><mxCell id="s1_engine" value="&lt;b&gt;ChromaDB Vector Retrieval&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#64748B;margin-top:4px;line-height:1.4;&quot;&gt;• Embeds bio, practice areas, experience&lt;br/&gt;• Real semantic similarity cosine scoring&lt;br/&gt;• Drops stale vectors / unapproved KYC&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="385" width="280" height="75" as="geometry" /></mxCell><mxCell id="s1_db" value="&lt;b style=&quot;color:#0369A1;&quot;&gt;MongoDB: users&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• role: lawyer, kyc_verified: true&lt;br/&gt;• lawyer_profile (bar_number, hourly_rate)&lt;br/&gt;• Exact geocoded office coordinates (lat/lng)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="870" width="280" height="85" as="geometry" /></mxCell><mxCell id="s2_ui" value="&lt;b style=&quot;color:#0D9488;font-size:12px;&quot;&gt;Booking Modal: Date &amp;amp; Slot Pick&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Opens with lawyer consultation fee (PKR)&lt;br/&gt;• Date picker scans &lt;b&gt;14 days earliest open hint&lt;/b&gt;&lt;br/&gt;• Displays only real bookable 60-min slots&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col2"><mxGeometry x="15" y="45" width="280" height="90" as="geometry" /></mxCell><mxCell id="s2_api" value="&lt;span style=&quot;background:#CCFBF1;color:#0F766E;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;GET&lt;/span&gt; &lt;b&gt;/lawyers/{id}/bookable-slots&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#E0F2FE;color:#0369A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;GET&lt;/span&gt; &lt;b&gt;/lawyers/{id}/availability&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#64748B;margin-top:4px;&quot;&gt;Params: from, to, duration_minutes=60 (PKT tz)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col2"><mxGeometry x="15" y="160" width="280" height="80" as="geometry" /></mxCell><mxCell id="s2_svc" value="&lt;b&gt;Slot Subtraction Math Engine&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;&lt;b&gt;Working Hours (from availability config)&lt;/b&gt;&lt;br/&gt;− Exception days (leaves / court holidays)&lt;br/&gt;− Active pending / confirmed appointments&lt;br/&gt;− &lt;b&gt;Court Hearings&lt;/b&gt;: holds 3 hrs (or full day)&lt;br/&gt;− Lawyer diary entries &amp;amp; past timestamps&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col2"><mxGeometry x="15" y="265" width="280" height="110" as="geometry" /></mxCell><mxCell id="s2_db" value="&lt;b style=&quot;color:#0F766E;&quot;&gt;MongoDB: lawyer_availability&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• _id: lawyer_id&lt;br/&gt;• working_hours (mon..sun start/end)&lt;br/&gt;• unavailable_dates &amp;amp; exception reasons&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#0D9488;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col2"><mxGeometry x="15" y="870" width="280" height="85" as="geometry" /></mxCell><mxCell id="s3_ui" value="&lt;b style=&quot;color:#D97706;font-size:12px;&quot;&gt;Submit Consultation Request&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Choose Mode: &lt;b&gt;Video call&lt;/b&gt; or &lt;b&gt;In person&lt;/b&gt;&lt;br/&gt;• Link confirmed Case ID (notes ≤ 1,000 chars)&lt;br/&gt;• Generates unique &lt;b&gt;idempotency key&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="45" width="280" height="90" as="geometry" /></mxCell><mxCell id="s3_api" value="&lt;span style=&quot;background:#FEF3C7;color:#B45309;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/api/v1/appointments&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#64748B;margin-top:4px;line-height:1.3;&quot;&gt;• Headers: Idempotency-Key&lt;br/&gt;• Body: {lawyer_id, scheduled_at, mode, case_id}&lt;br/&gt;• Rejects double-click (409 conflict if slot taken)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="160" width="280" height="80" as="geometry" /></mxCell><mxCell id="s3_svc" value="&lt;b&gt;appointment_service.book_appointment&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;• Validates future :00/:30 UTC offset&lt;br/&gt;• Verifies client case ownership (blocks draft)&lt;br/&gt;• Enforces lawyer KYC approval &amp;amp; active status&lt;br/&gt;• Atomically holds timeslot for both parties&lt;br/&gt;• Dispatches WebSocket notification to lawyer&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="265" width="280" height="110" as="geometry" /></mxCell><mxCell id="s3_state" value="&lt;b&gt;Status: PENDING&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#B45309;margin-top:3px;line-height:1.3;&quot;&gt;• Client can reschedule or cancel request&lt;br/&gt;• Client can attach up to 5 case files&lt;br/&gt;• Private thread locked until lawyer confirms&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;fontSize=10;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="395" width="280" height="75" as="geometry" /></mxCell><mxCell id="s3_db" value="&lt;b style=&quot;color:#D97706;&quot;&gt;MongoDB: appointments&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• status: &lt;b&gt;pending&lt;/b&gt;&lt;br/&gt;• Unique index on (lawyer_id, scheduled_at)&lt;br/&gt;• Unique index on (client_id, scheduled_at)&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="870" width="280" height="85" as="geometry" /></mxCell><mxCell id="s4_ui" value="&lt;b style=&quot;color:#7C3AED;font-size:12px;&quot;&gt;Lawyer Dashboard &amp;amp; Decision Triage&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Lawyer views pending consultation in /lawyer&lt;br/&gt;• Reviews client story, case type &amp;amp; documents&lt;br/&gt;• Three distinct decision actions available&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col4"><mxGeometry x="15" y="45" width="320" height="90" as="geometry" /></mxCell><mxCell id="s4_api" value="&lt;span style=&quot;background:#EDE9FE;color:#6D28D9;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;PATCH&lt;/span&gt; &lt;b&gt;/appointments/{id}/accept&lt;/b&gt; (Daily/link)&lt;br/&gt;&lt;span style=&quot;background:#FEE2E2;color:#991B1B;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;PATCH&lt;/span&gt; &lt;b&gt;/appointments/{id}/decline&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#E0F2FE;color:#0369A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/appointments/{id}/propose-reschedule&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col4"><mxGeometry x="15" y="160" width="320" height="80" as="geometry" /></mxCell><mxCell id="b_accept" value="&lt;b style=&quot;color:#059669;&quot;&gt;[PATH A] ACCEPT ➔ CONFIRMED&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#334155;margin-top:3px;line-height:1.3;&quot;&gt;• Creates &lt;b&gt;Daily.co video room&lt;/b&gt; token&lt;br/&gt;• Generates &lt;b&gt;.ics&lt;/b&gt; calendar invite download&lt;br/&gt;• Unlocks private in-app messaging thread&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="col4"><mxGeometry x="15" y="260" width="320" height="75" as="geometry" /></mxCell><mxCell id="b_decline" value="&lt;b style=&quot;color:#DC2626;&quot;&gt;[PATH B] DECLINE ➔ CANCELLED&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#334155;margin-top:3px;line-height:1.3;&quot;&gt;• status: cancelled, cancelled_by: lawyer&lt;br/&gt;• Slot freed up immediately in calendar&lt;br/&gt;• Client receives instant lawyer re-match tips&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#FECACA;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="col4"><mxGeometry x="15" y="350" width="320" height="75" as="geometry" /></mxCell><mxCell id="b_resched" value="&lt;b style=&quot;color:#D97706;&quot;&gt;[PATH C] PROPOSE NEW TIME&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#334155;margin-top:3px;line-height:1.3;&quot;&gt;• Lawyer suggests up to 3 alternate slots&lt;br/&gt;• Client selects slot ➔ updates scheduled_at&lt;br/&gt;• Old slot held until client responds&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#FDE68A;strokeWidth=1.5;fontSize=10;align=left;spacingLeft=10;" vertex="1" parent="col4"><mxGeometry x="15" y="440" width="320" height="75" as="geometry" /></mxCell><mxCell id="s4_db" value="&lt;b style=&quot;color:#7C3AED;&quot;&gt;Status Transitions in DB&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• &lt;b&gt;confirmed&lt;/b&gt;: meeting room generated&lt;br/&gt;• Cancellation locked inside 2h of start&lt;br/&gt;• Notifications broadcasted over WebSocket&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col4"><mxGeometry x="15" y="870" width="320" height="85" as="geometry" /></mxCell><mxCell id="s5_ui" value="&lt;b style=&quot;color:#DB2777;font-size:12px;&quot;&gt;Active Consultation Experience&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Countdown timer (&quot;Starts in 10 mins&quot;)&lt;br/&gt;• Pre-join hardware check (Mic/Camera test)&lt;br/&gt;• 60-min in-app WebRTC video room&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col5"><mxGeometry x="15" y="45" width="280" height="90" as="geometry" /></mxCell><mxCell id="s5_api" value="&lt;span style=&quot;background:#FCE7F3;color:#BE185D;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;GET&lt;/span&gt; &lt;b&gt;/appointments/{id}/video-token&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#E0F2FE;color:#0369A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/appointments/{id}/messages&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#EDE9FE;color:#6D28D9;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;WS&lt;/span&gt; &lt;b&gt;/ws/chat (appointment thread)&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col5"><mxGeometry x="15" y="160" width="280" height="80" as="geometry" /></mxCell><mxCell id="s5_svc" value="&lt;b&gt;WebRTC Video &amp;amp; Chat Engine&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;• Daily.co server integration (or external meeting link)&lt;br/&gt;• Ephemeral tokens minted with appointment expiry&lt;br/&gt;• Document previewing during active call&lt;br/&gt;• Auto-transitions to &lt;b&gt;ended&lt;/b&gt; after 60 mins&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col5"><mxGeometry x="15" y="265" width="280" height="100" as="geometry" /></mxCell><mxCell id="s5_db" value="&lt;b style=&quot;color:#DB2777;&quot;&gt;Media &amp;amp; Message Storage&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• appointment_messages collection&lt;br/&gt;• Daily.co session log &amp;amp; duration record&lt;br/&gt;• status: &lt;b&gt;confirmed ➔ ended&lt;/b&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#DB2777;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col5"><mxGeometry x="15" y="870" width="280" height="85" as="geometry" /></mxCell><mxCell id="s6_ui" value="&lt;b style=&quot;color:#059669;font-size:12px;&quot;&gt;Outcome &amp;amp; Critical Next Steps&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Lawyer marks: &lt;b&gt;Completed&lt;/b&gt; or &lt;b&gt;No-Show&lt;/b&gt;&lt;br/&gt;• Records consultation outcome &amp;amp; next advice&lt;br/&gt;• Unlocks client: &lt;b&gt;Hire Lawyer&lt;/b&gt; &amp;amp; &lt;b&gt;Review&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col6"><mxGeometry x="15" y="45" width="260" height="90" as="geometry" /></mxCell><mxCell id="s6_api" value="&lt;span style=&quot;background:#DCFCE7;color:#15803D;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/appointments/{id}/outcome&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#FEF3C7;color:#B45309;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/lawyers/{id}/review&lt;/b&gt; (1-5 stars)&lt;br/&gt;&lt;span style=&quot;background:#DCFCE7;color:#15803D;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/engagements/hire&lt;/b&gt; (Doc 15)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col6"><mxGeometry x="15" y="160" width="260" height="80" as="geometry" /></mxCell><mxCell id="s6_svc" value="&lt;b&gt;Post-Consultation &amp;amp; Hire Engine&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;• Sets appointment status = &lt;b&gt;completed&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;review-eligibility&lt;/b&gt; becomes true&lt;br/&gt;• Recalculates lawyer public rating&lt;br/&gt;• &lt;b&gt;GATEWAY&lt;/b&gt;: Completed consultation is mandatory prerequisite to send Hire Request&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col6"><mxGeometry x="15" y="265" width="260" height="110" as="geometry" /></mxCell><mxCell id="s6_next" value="&lt;b style=&quot;color:#059669;&quot;&gt;Unlocks Next Journey Steps&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.5;&quot;&gt;➔ &lt;b&gt;Hire Lawyer (Doc 15)&lt;/b&gt;: Fee proposal&lt;br/&gt;➔ &lt;b&gt;Case Opened (Doc 16)&lt;/b&gt;: Formal Case&lt;br/&gt;➔ &lt;b&gt;Public Review&lt;/b&gt;: Directory rating updated&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#A7F3D0;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col6"><mxGeometry x="15" y="400" width="260" height="85" as="geometry" /></mxCell><mxCell id="s6_db" value="&lt;b style=&quot;color:#059669;&quot;&gt;MongoDB: reviews &amp;amp; cases&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• reviews: stars, feedback, client_id&lt;br/&gt;• lawyer_profile.rating updated&lt;br/&gt;• engagements &amp;amp; case retainer unlocked&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col6"><mxGeometry x="15" y="870" width="260" height="85" as="geometry" /></mxCell><mxCell id="flow_1_2" style="strokeColor=#0284C7;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s1_ui" target="s2_ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_2_3" style="strokeColor=#0D9488;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s2_ui" target="s3_ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_3_4" style="strokeColor=#D97706;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="s3_ui" target="s4_ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_4_5" style="strokeColor=#059669;strokeWidth=2.5;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="b_accept" target="s5_ui"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="flow_5_6" style=