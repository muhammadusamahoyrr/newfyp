<mxfile host="app.diagrams.net" version="22.0.0" type="device"><diagram id="legal-intake-pipeline-clean" name="Legal Intake Architecture"><mxGraphModel dx="1800" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1850" pageHeight="1150" background="#F8FAFC" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="hdr" value="&lt;div style=&quot;font-size:16px;font-weight:800;color:#0F172A;&quot;&gt;Attorney.AI — Legal Intake Architecture &amp; Execution Pipeline&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#64748B;margin-top:3px;&quot;&gt;Clean 5-Stage Sequential Pipeline: Client UI → FastAPI Routes → Core Services → LangGraph AI Engine → Open Case&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;arcSize=6;align=left;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1720" height="55" as="geometry" /></mxCell><mxCell id="col1" value="  STAGE 1: INITIATION &amp; ROLE" style="swimlane;startSize=30;fillColor=#BAE6FD;strokeColor=#BAE6FD;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#F0F9FF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="50" y="95" width="270" height="960" as="geometry" /></mxCell><mxCell id="col2" value="  STAGE 2: STORY, VOICE &amp; EVIDENCE" style="swimlane;startSize=30;fillColor=#BAE6FD;strokeColor=#BAE6FD;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#F0F9FF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="360" y="95" width="290" height="960" as="geometry" /></mxCell><mxCell id="col3" value="  STAGE 3: ADAPTIVE CLARIFICATION" style="swimlane;startSize=30;fillColor=#BAE6FD;strokeColor=#BAE6FD;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#F0F9FF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="690" y="95" width="270" height="960" as="geometry" /></mxCell><mxCell id="col4" value="  STAGE 4: CONVERSION &amp; AI ENGINE" style="swimlane;startSize=30;fillColor=#DDD6FE;strokeColor=#DDD6FE;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#F5F3FF;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1000" y="95" width="440" height="960" as="geometry" /></mxCell><mxCell id="col5" value="  STAGE 5: REVIEW, CONFIRM &amp; OPEN" style="swimlane;startSize=30;fillColor=#A7F3D0;strokeColor=#A7F3D0;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#ECFDF5;collapsible=0;" vertex="1" parent="1"><mxGeometry x="1480" y="95" width="290" height="960" as="geometry" /></mxCell><mxCell id="s1_ui" value="&lt;b style=&quot;color:#0284C7;font-size:12px;&quot;&gt;Step 1: About You&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Select Province (Punjab, Sindh, etc.)&lt;br/&gt;• Role: Plaintiff vs Defendant&lt;br/&gt;• Form validation gate&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="45" width="240" height="85" as="geometry" /></mxCell><mxCell id="s1_api" value="&lt;span style=&quot;background:#E0F2FE;color:#0369A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/intake/start&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#FEF3C7;color:#B45309;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;PATCH&lt;/span&gt; &lt;b&gt;/intake/{token}/step/1&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#64748B;margin-top:4px;&quot;&gt;Rate limit: 10/min | Returns session_token&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="160" width="240" height="80" as="geometry" /></mxCell><mxCell id="s1_svc" value="&lt;b&gt;intake_service.py&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;• Resume check for unfinished drafts&lt;br/&gt;• Generates cryptographically secure token&lt;br/&gt;• Validates &amp; saves step 1 payload&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="270" width="240" height="85" as="geometry" /></mxCell><mxCell id="s1_db" value="&lt;b style=&quot;color:#0369A1;&quot;&gt;MongoDB: intakes&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• session_token (unique index)&lt;br/&gt;• client_id &amp; step1 data&lt;br/&gt;• completed = false&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col1"><mxGeometry x="15" y="840" width="240" height="85" as="geometry" /></mxCell><mxCell id="s2_ui" value="&lt;b style=&quot;color:#0284C7;font-size:12px;&quot;&gt;Step 2: Your Story &amp; Media&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Incident story (min 5 words, 20 chars)&lt;br/&gt;• &lt;b&gt;120s Voice note&lt;/b&gt; (WAV 16kHz recorder)&lt;br/&gt;• Evidence upload (PDF, DOCX, images)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col2"><mxGeometry x="15" y="45" width="260" height="85" as="geometry" /></mxCell><mxCell id="s2_api" value="&lt;span style=&quot;background:#DCFCE7;color:#15803D;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/voice/transcribe&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#DCFCE7;color:#15803D;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/intake/{token}/evidence&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#FEF3C7;color:#B45309;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;PATCH&lt;/span&gt; &lt;b&gt;/step/2, 3, 4, 5&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col2"><mxGeometry x="15" y="160" width="260" height="80" as="geometry" /></mxCell><mxCell id="s2_svc" value="&lt;b&gt;Voice &amp; Evidence Handlers&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;• Whisper STT (Urdu / Roman / Eng)&lt;br/&gt;• MIME re-sniff &amp; 10MB size gate&lt;br/&gt;• Quick classify chips (Family, Civil..)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col2"><mxGeometry x="15" y="270" width="260" height="85" as="geometry" /></mxCell><mxCell id="s2_db" value="&lt;b style=&quot;color:#475569;&quot;&gt;Encrypted Disk Storage&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• uploads/evidence/{token}/{file_id}&lt;br/&gt;• Raw bytes preserved for OCR&lt;br/&gt;• 365-day retention policy sweep&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col2"><mxGeometry x="15" y="840" width="260" height="85" as="geometry" /></mxCell><mxCell id="s3_ui" value="&lt;b style=&quot;color:#0284C7;font-size:12px;&quot;&gt;Step 3: AI Questions&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Adaptive clarification (up to 4 Qs)&lt;br/&gt;• Quick reply chips (&quot;Not sure&quot;, &quot;Unknown&quot;)&lt;br/&gt;• &quot;Continue without questions&quot; button&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="45" width="240" height="85" as="geometry" /></mxCell><mxCell id="s3_api" value="&lt;span style=&quot;background:#E0F2FE;color:#0369A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/intake/{token}/clarify&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#64748B;margin-top:4px;line-height:1.4;&quot;&gt;• Body: {answer?, language?}&lt;br/&gt;• Rate limit: 12/min (concurrency safe)&lt;br/&gt;• Returns: {question, done, round}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="160" width="240" height="80" as="geometry" /></mxCell><mxCell id="s3_svc" value="&lt;b&gt;Clarification Logic&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;• Evaluates story gaps &amp; missing elements&lt;br/&gt;• Max 5,000 characters per answer&lt;br/&gt;• Appends to clarification_qa ledger&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="270" width="240" height="85" as="geometry" /></mxCell><mxCell id="s3_db" value="&lt;b style=&quot;color:#0369A1;&quot;&gt;MongoDB: intakes&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.3;&quot;&gt;• Updates clarification_qa array&lt;br/&gt;• current_step = 3 progress saved&lt;br/&gt;• Ready for case convert trigger&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col3"><mxGeometry x="15" y="840" width="240" height="85" as="geometry" /></mxCell><mxCell id="s4_ui" value="&lt;b style=&quot;color:#6D28D9;font-size:12px;&quot;&gt;Trigger: &quot;Build My Case&quot;&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Client requests structured case synthesis&lt;br/&gt;• Displays dynamic analysis loader screen&lt;br/&gt;• Sets target language (English vs Urdu)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col4"><mxGeometry x="15" y="45" width="410" height="85" as="geometry" /></mxCell><mxCell id="s4_api" value="&lt;span style=&quot;background:#EDE9FE;color:#6D28D9;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;POST&lt;/span&gt; &lt;b&gt;/api/v1/intake/{token}/convert&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#64748B;margin-top:4px;line-height:1.3;&quot;&gt;• Rate limit: 6/min with atomic epoch fence&lt;br/&gt;• Replays cached result if already completed&lt;br/&gt;• Returns: {case_id, ai_case_type, type_was_corrected}&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col4"><mxGeometry x="15" y="160" width="410" height="80" as="geometry" /></mxCell><mxCell id="s4_svc" value="&lt;b style=&quot;color:#0F172A;&quot;&gt;Conversion Pipeline (intake_service.py)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;1. &lt;b&gt;claim_conversion&lt;/b&gt; (atomic lock, epoch++) ➔ blocks 409 collisions&lt;br/&gt;2. &lt;b&gt;_extract_intake_evidence&lt;/b&gt; (subprocess parser for PDF/DOCX + OCR)&lt;br/&gt;3. &lt;b&gt;_ai_classify_case_type&lt;/b&gt; (rule keywords + LLM fallback classification)&lt;br/&gt;4. &lt;b&gt;build_understanding&lt;/b&gt; (compiles verified Fact Ledger from Q&amp;A)&lt;br/&gt;5. &lt;b&gt;case_service.create_case(status=&quot;draft&quot;)&lt;/b&gt; ➔ pins case_id to intake&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col4"><mxGeometry x="15" y="265" width="410" height="100" as="geometry" /></mxCell><mxCell id="s4_graph_box" value="  LANGGRAPH INTAKE GRAPH (build_intake_graph in supervisor.py)" style="swimlane;startSize=26;fillColor=#6D28D9;strokeColor=#5B21B6;fontColor=#FFFFFF;fontStyle=1;fontSize=10;rounded=1;arcSize=4;shadow=1;swimlaneFillColor=#FFFFFF;collapsible=0;" vertex="1" parent="col4"><mxGeometry x="15" y="385" width="410" height="290" as="geometry" /></mxCell><mxCell id="g_n1" value="&lt;b&gt;1. retrieval_node&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#64748B;&quot;&gt;ChromaDB vector query &amp; statute affinity&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;fontSize=10;align=center;" vertex="1" parent="s4_graph_box"><mxGeometry x="15" y="38" width="180" height="45" as="geometry" /></mxCell><mxCell id="g_n2" value="&lt;b&gt;2. retrieval_grader&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#64748B;&quot;&gt;RRF rank fusion &amp; topic rules&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;fontSize=10;align=center;" vertex="1" parent="s4_graph_box"><mxGeometry x="215" y="38" width="180" height="45" as="geometry" /></mxCell><mxCell id="g_n3" value="&lt;b style=&quot;color:#C2410C;&quot;&gt;3. evidence_gate_node (CRITICAL GATE)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#475569;&quot;&gt;Verifies jurisdiction, live law &amp; repeals.&lt;br/&gt;If law missing/unsupported ➔ &lt;b&gt;Forces Facts-Only Mode&lt;/b&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;strokeWidth=1.5;fontSize=10;align=center;" vertex="1" parent="s4_graph_box"><mxGeometry x="15" y="100" width="380" height="50" as="geometry" /></mxCell><mxCell id="g_n4" value="&lt;b&gt;4. intake_node (LLM)&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#64748B;&quot;&gt;Writes Summary, Law (≤6), Risk&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;fontSize=10;align=center;" vertex="1" parent="s4_graph_box"><mxGeometry x="15" y="168" width="180" height="45" as="geometry" /></mxCell><mxCell id="g_n5" value="&lt;b&gt;5. hallucination_node&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#64748B;&quot;&gt;Citation check &amp; grounding verdict&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;fontSize=10;align=center;" vertex="1" parent="s4_graph_box"><mxGeometry x="215" y="168" width="180" height="45" as="geometry" /></mxCell><mxCell id="g_n6" value="&lt;b&gt;6. intake_finalizer_node&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;font-size:9px;color:#64748B;&quot;&gt;Repeal currency stamps &amp; separates general vs legal action steps&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#C4B5FD;fontSize=10;align=center;" vertex="1" parent="s4_graph_box"><mxGeometry x="15" y="230" width="380" height="45" as="geometry" /></mxCell><mxCell id="eg1" style="strokeColor=#7C3AED;strokeWidth=1.5;" edge="1" parent="s4_graph_box" source="g_n1" target="g_n2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eg2" style="strokeColor=#7C3AED;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="s4_graph_box" source="g_n2" target="g_n3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eg3" style="strokeColor=#EA580C;strokeWidth=1.5;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="s4_graph_box" source="g_n3" target="g_n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eg4" style="strokeColor=#7C3AED;strokeWidth=1.5;" edge="1" parent="s4_graph_box" source="g_n4" target="g_n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="eg5" style="strokeColor=#7C3AED;strokeWidth=1.5;exitX=0.5;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="s4_graph_box" source="g_n5" target="g_n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="s4_guards" value="&lt;b&gt;Post-Graph Compliance Guards&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:3px;line-height:1.4;&quot;&gt;• &lt;b&gt;fact_fidelity&lt;/b&gt;: checks numbers/negations against user story&lt;br/&gt;• &lt;b&gt;apply_intake_cpc&lt;/b&gt;: applies Punjab-only CPC filter&lt;br/&gt;• &lt;b&gt;Urdu localization&lt;/b&gt;: renders high-quality Urdu translation if chosen&lt;br/&gt;• Saves ai_structured_case to DB &amp; marks intake completed&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col4"><mxGeometry x="15" y="695" width="410" height="95" as="geometry" /></mxCell><mxCell id="s4_db" value="&lt;b style=&quot;color:#6D28D9;&quot;&gt;ChromaDB &amp; Provenance Audit&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#475569;margin-top:3px;line-height:1.3;&quot;&gt;• Vector corpus of Pakistani statutes &amp; provisions&lt;br/&gt;• SHA-256 audit record stamped in provenance collection&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=1.5;shadow=1;align=left;spacingLeft=12;" vertex="1" parent="col4"><mxGeometry x="15" y="840" width="410" height="85" as="geometry" /></mxCell><mxCell id="s5_ui" value="&lt;b style=&quot;color:#059669;font-size:12px;&quot;&gt;Step 4 &amp; 5: Review &amp; Confirm&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#334155;margin-top:4px;line-height:1.4;&quot;&gt;• Review Summary, Laws &amp; Risk estimate&lt;br/&gt;• Urdu/English toggle &amp; PDF Print export&lt;br/&gt;• Confirm/edit Category (Family, Civil, etc.)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col5"><mxGeometry x="15" y="45" width="260" height="85" as="geometry" /></mxCell><mxCell id="s5_api" value="&lt;span style=&quot;background:#E0F2FE;color:#0369A1;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;GET&lt;/span&gt; &lt;b&gt;/intake/{token}&lt;/b&gt;&lt;br/&gt;&lt;span style=&quot;background:#DCFCE7;color:#15803D;padding:1px 5px;border-radius:3px;font-size:9px;font-weight:700;&quot;&gt;PATCH&lt;/span&gt; &lt;b&gt;/cases/{case_id}/confirm&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:9px;color:#64748B;margin-top:4px;&quot;&gt;Confirms case_type &amp; stamps confirmed_at&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col5"><mxGeometry x="15" y="160" width="260" height="80" as="geometry" /></mxCell><mxCell id="s5_svc" value="&lt;b&gt;Case Service (case_service.py)&lt;/b&gt;&lt;br/&gt;&lt;div style=&quot;font-size:10px;color:#475569;margin-top:4px;line-height:1.4;&quot;&gt;• Transitions status: &lt;b&gt;draft ➔ open&lt;/b&gt;&lt;br/&gt;• Saves user-confirmed case category&lt;br/&gt;• Case becomes visible for lawyer matching&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;" vertex="1" parent="col5"><mxGeometry x="15" y="270" wi