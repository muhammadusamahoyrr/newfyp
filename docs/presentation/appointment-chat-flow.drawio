    <mxCell id="hdr" parent="1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;shadow=1;arcSize=6;align=left;spacingLeft=16;" value="&lt;div style=&quot;font-size:16px;font-weight:800;color:#0F172A;&quot;&gt;Attorney.AI — Client ↔ Lawyer Appointment Chat&lt;/div&gt;&lt;div style=&quot;font-size:11px;color:#64748B;margin-top:3px;&quot;&gt;One private chat per appointment · Send via REST → Safe save (transaction) → Live WebSocket notification → Chat reloads → Read / unread&lt;/div&gt;">
      <mxGeometry x="50" y="25" width="1720" height="50" as="geometry" />
    </mxCell>

    <!-- STAGE 1 -->
    <mxCell id="col1" parent="1" vertex="1" value="  1. CHAT OPENS" style="swimlane;startSize=30;fillColor=#BAE6FD;strokeColor=#BAE6FD;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#EFF6FF;collapsible=0;">
