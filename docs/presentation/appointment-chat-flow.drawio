      <mxGeometry x="15" y="45" width="280" height="60" as="geometry" />
    </mxCell>
    <mxCell id="s1_api" parent="col1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;fontSize=10;" value="&lt;b&gt;GET&lt;/b&gt; /appointments/{id}/messages&lt;br/&gt;(30 per page, scroll up for older)">
      <mxGeometry x="15" y="135" width="280" height="50" as="geometry" />
    </mxCell>
    <mxCell id="s1_svc" parent="col1" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;shadow=1;arcSize=8;align=left;spacingLeft=12;fontSize=10;" value="&lt;b&gt;Who &amp;amp; when&lt;/b&gt;&lt;br/&gt;• Only this client &amp;amp; this lawyer&lt;br/&gt;• Pending → locked · Confirmed → open&lt;br/&gt;• Ended → read-only (history kept)">
      <mxGeometry x="15" y="215" width="280" height="80" as="geometry" />
    </mxCell>
    <mxCell id="s1_db" parent="col1" vertex="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=8;fillColor=#FFFFFF;strokeColor=#0284C7;strokeWidth=1.5;shadow=1;fontSize=10;" value="&lt;b&gt;MongoDB&lt;/b&gt;&lt;br/&gt;appointments (status)">
