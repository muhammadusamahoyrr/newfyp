    <!-- STAGE 2 -->
    <mxCell id="col2" parent="1" vertex="1" value="  2. SEND A MESSAGE" style="swimlane;startSize=30;fillColor=#99F6E4;strokeColor=#99F6E4;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#F0FDFA;collapsible=0;">
