    <mxCell id="col3" parent="1" vertex="1" value="  3. SAVE SAFELY" style="swimlane;startSize=30;fillColor=#FDE68A;strokeColor=#FDE68A;fontColor=#0F172A;fontStyle=1;fontSize=11;rounded=1;arcSize=6;shadow=1;swimlaneFillColor=#FEF3C7;collapsible=0;">
